// Cloudflare Worker for the KMS release site (6B D8, A5). Static files, plus
// worker.js for /ui/* only, which sets the cache rule by response status.
// Cloudflare's GitHub connection deploys the main branch; no token is stored here.
{
  "name": "kms-test",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ui/*"]
  }
}
